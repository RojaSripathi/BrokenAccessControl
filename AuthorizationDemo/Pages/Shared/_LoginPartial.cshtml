@using Microsoft.AspNetCore.Identity
@inject SignInManager<AuthorizationDemo.Models.ApplicationUser> SignInManager
@inject UserManager<AuthorizationDemo.Models.ApplicationUser> UserManager

<ul class="nav navbar-nav navbar-right">
@if (SignInManager.IsSignedIn(User))
{
    <li><a asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage your account">Hello, @User.Identity?.Name!</a></li>
    <li>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page(\"/Index\")" method="post" class="navbar-form navbar-right">
            <button type="submit" class="btn btn-link navbar-btn navbar-link">Log off</button>
        </form>
    </li>
}
else
{
    <li><a asp-area="Identity" asp-page="/Account/Register">Register</a></li>
    <li><a asp-area="Identity" asp-page="/Account/Login">Log in</a></li>
}
</ul>
